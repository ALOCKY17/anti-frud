# Set this from the output of `stripe listen --forward-to localhost:4242/webhooks/stripe`.
# Never use a live-mode webhook secret with this local test-mode app.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_test_mode_signing_secret

# Optional: payments in this currency at or above the threshold get +10 review points.
# Stripe amounts are in that currency's smallest unit (for example, 100000 = $1,000.00 USD).
HIGH_VALUE_MINOR=100000
HIGH_VALUE_CURRENCY=usd
